# General Settings
theme = "catppuccin-mocha"
macos-non-native-fullscreen = true
macos-titlebar-style = tabs
window-save-state = never
term = xterm-256color
cursor-color = "#7A7A7A"

# Fonts
font-family = "Fira Code"
font-size = 18.0

# window layout
window-padding-balance = true
window-padding-x = 5
window-padding-y = 12,5

# global keybinds
keybind = ctrl+b>r=reload_config
keybind = global:ctrl+enter=toggle_quick_terminal

# window and split management
keybind = ctrl+b>c=new_tab
keybind = ctrl+b>v=new_split:right
keybind = ctrl+b>-=new_split:down
keybind = ctrl+b>equal=equalize_splits
keybind = ctrl+b>k=goto_split:top
keybind = ctrl+b>j=goto_split:bottom
keybind = ctrl+b>h=goto_split:left
keybind = ctrl+b>l=goto_split:right
keybind = ctrl+b>f=toggle_split_zoom

keybind = cmd+shift+left=move_tab:-1
keybind = cmd+shift+right=move_tab:1
keybind = ctrl+b>1=goto_tab:1
keybind = ctrl+b>2=goto_tab:2
keybind = ctrl+b>3=goto_tab:3
keybind = ctrl+b>4=goto_tab:4
keybind = ctrl+b>5=goto_tab:5
keybind = ctrl+b>6=goto_tab:6
keybind = ctrl+b>7=goto_tab:7
keybind = ctrl+b>8=goto_tab:8
keybind = ctrl+b>9=goto_tab:9
keybind = ctrl+b>0=goto_tab:10


